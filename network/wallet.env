# network/wallet.env: what the wallet proxy needs on the wallet servers.
# Committed, nothing secret, the same on both servers; a new validator is a
# new entry in both lists, then a pull and a restart on each server. Each
# unit sets its own EDITION and PORT. Development needs no env file: every
# value has a local default in server/config.js.

# The masterpod.
MASTERPOD_URL=https://api.anocloud.com

# The validators and the keyholders, one entry per registry row, in registry
# order: each validator's doorman, 3000 the validator door, 3200 the
# keyholder door. The browser addresses them by their position here.
VALIDATOR_URLS=https://35.237.125.139:3000,https://8.229.28.4:3000,https://35.224.15.68:3000,https://34.62.195.135:3000,https://34.6.221.211:3000,https://207.175.84.141:3000
KEYHOLDER_URLS=https://35.237.125.139:3200,https://8.229.28.4:3200,https://35.224.15.68:3200,https://34.62.195.135:3200,https://34.6.221.211:3200,https://207.175.84.141:3200

# The signing server, signing1, plain HTTP; its firewall admits the two
# wallet servers only.
SIGNING_SERVER_URL=http://2.31.157.207:3300

# How many of the keyholders' shares rebuild a secret. May be raised later,
# never lowered: a deposit split under a higher number needs that many.
SHARE_THRESHOLD=4

# How many of the listed keyholders must store a share for a deposit to go
# through, in percent, rounded up and never below SHARE_THRESHOLD: 80 of 27
# is 22. A keyholder that is down misses that share for good; the secret
# still rebuilds from any SHARE_THRESHOLD of the others.
DEPOSIT_FLOOR_PERCENT=80

# The one validator the browser talks to, by position in VALIDATOR_URLS.
DEFAULT_VALIDATOR=1

# The WebAuthn relying-party id, the masterpod's RP_ID: one fixed id on all
# three wallet names.
RP_ID=wallet.anocloud.com

# The time locks on guarded and vault accounts and the offset, in minutes:
# the same three numbers as the validators' GUARDED_LOCK_MINUTES,
# VAULT_LOCK_MINUTES and LOCK_OFFSET_MINUTES in anossoftware's
# network/testnet.env (10, 20 and 5 on the testnet; a week, a month and 10
# in production). The wallet dates a guarded or vault transfer the lock
# plus the offset ahead, and a validator refuses one dated less than the
# lock or more than the lock plus the offset ahead, so the two files must
# agree: change them together.
GUARDED_LOCK_MINUTES=10
VAULT_LOCK_MINUTES=20
LOCK_OFFSET_MINUTES=5
