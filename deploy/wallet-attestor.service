[Unit]
Description=anos wallet, attestor edition
Wants=network-online.target
After=network-online.target

[Service]
User=wallet
WorkingDirectory=/opt/wallet/web_app
Environment=EDITION=attestor
Environment=PORT=4301
ExecStart=/usr/bin/node --env-file=network/wallet.env server/index.js
Restart=always
RestartSec=5
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
